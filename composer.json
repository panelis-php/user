{
  "name": "panelis-php/user",
  "description": "Manage users, roles, and permissions for the application",
  "keywords": [
    "panelis"
  ],
  "authors": [
    {
      "name": "Yugo",
      "email": "dedy.yugo.purwanto@gmail.com"
    }
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "lorisleiva/laravel-actions": "^2.10",
    "laravel/framework": "^13.0",
    "filament/filament": "^5.0",
    "spatie/laravel-permission": "^8.0",
    "spatie/laravel-translation-loader": "^2.8"
  },
  "require-dev": {
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.4",
    "pestphp/pest-plugin-laravel": "^4.1"
  },
  "autoload": {
    "psr-4": {
      "Panelis\\User\\": "src/",
      "Panelis\\User\\Database\\Factories\\": "database/factories/",
      "Panelis\\User\\Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Panelis\\User\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "platform": {
      "php": "8.3"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Panelis\\User\\Providers\\UserServiceProvider"
      ]
    },
    "panelis": {
      "plugins": [
        "Panelis\\User\\Plugins\\UserPlugin"
      ],
      "permissions": {
        "user": "Panelis\\User\\Panel\\Resources\\UserResource\\Enums\\UserPermission",
        "role": "Panelis\\User\\Panel\\Resources\\RoleResource\\Enums\\RolePermission",
        "permission": "Panelis\\User\\Panel\\Resources\\PermissionResource\\Enums\\Permission"
      }
    }
  }
}
